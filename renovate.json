{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff"
  ],
  "timezone": "America/New_York",
  "schedule": ["* 0-5 * * *"],
  "automergeSchedule": ["* 0-5 * * *"],
  "automergeType": "pr",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 10,
  "reviewers": ["sirkitree"],
  "assignees": ["sirkitree"],
  "commitMessagePrefix": "chore(deps):",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "groupName": "development-dependencies",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "matchDepTypes": ["dependencies"],
      "groupName": "production-dependencies",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Keep Slack SDK updates separate so they don't block automerge of the rest of production-dependencies",
      "matchPackageNames": ["@slack/**"],
      "groupName": "slack-sdk",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "commitMessagePrefix": "ci:"
    },
    {
      "description": "Automerge non-major updates nightly once CI passes",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Majors and runtime-sensitive packages always need a human (TS7 broke the plugin loader; Slack payload changes only show under live traffic)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchPackageNames": ["typescript", "@slack/**"],
      "automerge": false
    },
    {
      "matchDepNames": ["node"],
      "automerge": false
    },
    {
      "description": "overrides are deliberate security pins (Sept 2025 npm hijack); always review bumps by hand",
      "matchDepTypes": ["overrides"],
      "automerge": false
    }
  ]
}
